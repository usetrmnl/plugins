<% if defined?(errors) && errors.present? %>
  <%= render partial: 'plugins/errors/half_vertical', locals: {
        icon: 'enphase--render.svg', title: 'Enphase', instance: instance_name, error_message: errors } %>
<% else %>
  <div class="view view--half_vertical">
    <div class="layout layout--col gap">
      <%= render partial: 'plugins/enphase/hero', locals: local_assigns.merge(value_class: 'value--xlarge') %>

      <%= render partial: 'plugins/enphase/totals', locals: local_assigns.merge(
            value_class: 'value--small', metric_keys: %i[produced consumed exported imported], grid_column_count: 2) %>

      <%= render partial: 'plugins/enphase/curve', locals: local_assigns.merge(max_x_axis_labels: 4) %>
    </div>

    <%= render partial: 'plugins/enphase/title_bar', locals: { instance_name:, last_report_label: } %>
  </div>
<% end %>
