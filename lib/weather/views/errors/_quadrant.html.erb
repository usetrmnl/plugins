<div class="view view--quadrant">
  <div class="layout">
    <div class="columns">
      <div class="column">
        <% if defined?(error_title) %>
          <span class="title" data-pixel-perfect="true"><%= error_title %></span>
        <% end %>
        <div class="richtext richtext--left gap--large">
          <div class="content content--left gap text--left">
            <p><%= error_message %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="title_bar">
    <%= image_tag plugin_image_path(icon), class: adaptive_icon_classes(icon), alt: "Error icon" %>
    <span class="title"><%= title %></span>
    <span class="instance"><%= instance %></span>
  </div>
</div>
