<% unless (defined?(errors) && errors.present?) %>
  <%= render partial: "plugins/weather/#{local_assigns[:data_provider] || 'weatherapi'}_full", locals: local_assigns %>
<% else %>
  <%= render partial: 'plugins/errors/full', locals: {
    icon: 'weather--render.svg',
    title: t('renders.weather.title'),
    instance: instance_name,
    error_message: errors
  } %>
<% end %>
