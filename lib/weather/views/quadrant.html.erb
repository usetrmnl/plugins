<% unless (defined?(errors) && errors.present?) %>
  <%= render partial: "plugins/weather/#{local_assigns[:data_provider] || 'weatherapi'}_quadrant", locals: local_assigns %>
<% else %>
  <%= render partial: 'plugins/errors/quadrant', locals: {
    icon: 'weather--render.svg',
    title: t('renders.weather.title', locale:),
    instance: instance_name,
    error_message: errors
  } %>
<% end %>
