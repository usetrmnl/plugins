<div class="view view--full">
  <div class="layout layout--col gap--auto">
    <div class="grid grid--cols-6">
      <div class="row row--center col--span-2 portrait:col--span-6 col--end">
        <%= image_tag inline_svg_src(weather_image), class: "w--[22cqw] h--[22cqw] portrait:w--auto portrait:h--[20cqh] lg:w--[28cqw] lg:h--[28cqw] lg:portrait:w--auto lg:portrait:h--[20cqh]", style: "filter: brightness(0.5) saturate(0%);", alt: "Weather condition" %>
      </div>
      <div class="col col--span-2 portrait:col--span-3 col--end">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--xxxlarge lg:value--giga" data-fit-value="true"><%= temperature&.round %>°</span>
            <span class="label w--full gap--xlarge">
              <div class="flex gap--xsmall flex--row flex--center-y">
                <%= image_tag plugin_image_path("weather/wi-sunrise.svg"), class: "image--adaptive h--6", alt: "Sunrise" %>
                <%= forecast[:right_now][:sunrise] %>
              </div>
              <div class="flex gap--xsmall flex--row flex--center-y">
                <%= image_tag plugin_image_path("weather/wi-sunset.svg"), class: "image--adaptive h--6", alt: "Sunset" %>
                <%= forecast[:right_now][:sunset] %>
              </div>
            </span>
            <span class="label w--full gap--xsmall">
              <%= image_tag inline_svg_src("https://tempestwx.com/images/Updated/wind-arrow-#{forecast[:right_now][:wind][:direction_cardinal].downcase}.svg"), class: "h--6", alt: "Wind direction" %>
              <%= forecast[:right_now][:wind][:gust] %> <%= forecast[:right_now][:wind][:units] %> | <%= t('renders.weather.max') %> <%= forecast[:right_now][:wind][:max] %>
            </span>
          </div>
        </div>
      </div>
      <div class="col col--span-2 portrait:col--span-3 col--end gap--medium">
        <div class="item">
          <div class="meta"></div>
          <div class="icon">
            <%= image_tag plugin_image_path("weather/wi-thermometer.svg"), class: "image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", alt: "Temperature" %>
          </div>
          <div class="content">
            <span class="value value--xsmall lg:value--large"><%= feels_like&.round %>°</span>
            <span class="label"><%= t('renders.weather.feels_like') %></span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="icon">
            <%= image_tag plugin_image_path("weather/wi-raindrops.svg"), class: "image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", alt: "Humidity" %>
          </div>
          <div class="content">
            <span class="value value--xsmall lg:value--large"><%= humidity %>%</span>
            <span class="label"><%= t('renders.weather.humidity') %></span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="icon">
            <%= image_tag inline_svg_src(weather_image), class: "w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", style: "filter: brightness(0.5) saturate(0%);", alt: "Weather condition" %>
          </div>
          <div class="content">
            <span class="value value--xsmall lg:value--base"><%= right_now_conditions %></span>
            <span class="label"><%= t('renders.weather.right_now') %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <div class="grid">
      <div class="col gap--large">
        <% [
          { key: :today, image: today_weather_image, translation_key: 'renders.weather.today', alt: 'Today weather condition' },
          { key: :tomorrow, image: tomorrow_weather_image, translation_key: 'renders.weather.tomorrow', alt: 'Tomorrow weather condition' }
        ].each do |day| %>
          <div class="grid">
            <div class="item col--span-3 h--full">
              <div class="meta"></div>
              <div class="icon">
                <%= image_tag inline_svg_src(day[:image]), class: "w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", style: "filter: brightness(0.5) saturate(0%);", alt: day[:alt] %>
              </div>
              <div class="content">
                <span class="value value--xsmall lg:value--base"><%= forecast[day[:key]][:conditions] %></span>
                <span class="label"><%= forecast[day[:key]][:day_override] || t(day[:translation_key]) %></span>
              </div>
            </div>

            <div class="item col--span-3 h--full">
              <div class="meta"></div>
              <div class="icon portrait:hidden">
                <%= image_tag plugin_image_path("weather/wi-hot.svg"), class: "image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", alt: "UV Index" %>
              </div>
              <div class="content">
                <span class="value value--xsmall lg:value--base"><%= forecast[day[:key]][:uv_index] %></span>
                <span class="label"><%= t('renders.weather.uv') %></span>
              </div>
            </div>

            <div class="item col--span-3 h--full">
              <div class="meta"></div>
              <div class="icon portrait:hidden">
                <%= image_tag inline_svg_src("https://tempestwx.com/images/Updated/#{forecast[day[:key]][:precip][:icon]}.svg"), class: "w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", style: "filter: brightness(0.5) saturate(0%);", alt: "Precipitation" %>
              </div>
              <div class="content" style="<%= 'justify-content: center' if day[:key] == :tomorrow %>">
                <span class="value value--xsmall lg:value--base"><%= forecast[day[:key]][:precip][:probability] %>%</span>
                <% if forecast[day[:key]][:precip][:amount].present? %>
                  <span class="label"><%= forecast[day[:key]][:precip][:amount].round(1) %> <%= forecast[day[:key]][:precip][:units] %></span>
                <% end %>
              </div>
            </div>

            <div class="row col--span-3 h--full self--stretch" style="align-items: stretch; height: 100%;">
              <div class="item">
                <div class="meta"></div>
                <div class="icon portrait:hidden">
                  <%= image_tag plugin_image_path("weather/wi-thermometer.svg"), class: "image--adaptive w--[6cqw] h--[6cqw] portrait:w--[10cqw] portrait:h--[10cqw]", alt: "Temperature" %>
                </div>
                <div class="content">
                  <div class="flex flex--row gap--xlarge portrait:gap">
                    <div class="content">
                      <span class="value value--xsmall lg:value--base"><%= forecast[day[:key]][:mintemp]&.round %>°</span>
                      <span class="label"><%= t('renders.weather.low') %></span>
                    </div>
                    <div class="content">
                      <span class="value value--xsmall lg:value--base"><%= forecast[day[:key]][:maxtemp]&.round %>°</span>
                      <span class="label"><%= t('renders.weather.high') %></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="title_bar">
    <%= image_tag plugin_image_path("tempest_weather_station--render.svg"), class: "image image--adaptive" %>
    <h1 class="title"><%= t('renders.weather.title') %></h1>
    <span class="instance"><%= instance_name %> (<%= render 'plugins/weather/render_time', utc_offset:, time_format: %>)</span>
  </div>
</div>

<%= render 'plugins/weather/common' %>
