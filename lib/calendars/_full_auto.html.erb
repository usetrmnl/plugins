<% zoom_mode ||= false %>
<% event_layout = local_assigns[:event_layout] %>
<% vertical_alignment = local_assigns[:vertical_alignment] %>
<% events = local_assigns[:events] %>
<% today_in_tz = local_assigns[:today_in_tz] %>
<% date_format = local_assigns[:date_format] %>
<% highlight_today = local_assigns[:highlight_today] %>
<% include_description = local_assigns[:include_description] %>
<% include_event_time = local_assigns[:include_event_time] %>

<% days_to_show = event_layout == 'today_only' ? 1 : 3 %>
<% max_event_reduction = zoom_mode ? 1 : 0 %>
<% date_heading_size = zoom_mode ? 'large' : 'medium' %>
<% heading_size = zoom_mode ? 'medium' : 'small' %>
<% sub_heading_size = zoom_mode ? 'small' : 'xsmall' %>
<% event_time_style = zoom_mode ? 'inverted' : 'underline' %>
<% alignment_class = vertical_alignment == 'top' ? ' layout--top' : (vertical_alignment == 'bottom' ? ' layout--bottom' : '') %>
<% today_label = today_date_label(today_in_tz, date_format, highlight: highlight_today) %>

<div class="view view--full">
  <% if events.blank? %>
    <div class="layout layout--center layout--middle h--full">
      <span class="title text--gray-50"><%= event_layout == 'today_only' ? t('renders.calendars.no_events_today') : t('renders.calendars.no_upcoming_events') %></span>
    </div>
  <% else %>
    <div class="layout layout--col<%= alignment_class %>">
      <div class="columns" data-overflow-max-cols="3" data-overflow-counter="true">
        <div class="column">
          <% idx = 0 %>
          <% formulate_and_group_events_by_day(events, today_in_tz, days_to_show, date_format).to_h.each_pair do |day, events| %>
            <span class="label label--<%= date_heading_size %><%= ' label--filled' if day == today_label %> group-header" data-group-header="true"><%= day %></span>
            <% events.each do |event| %>
              <% if event[:all_day] %>
                  <%= render partial: 'plugins/calendars/all_day_event', locals: { event: event, include_description:, heading_size: } %>
              <% else %>
                <div class="item">
                  <div class="meta">
                    <span class="index"><%= idx += 1 %></span>
                  </div>
                  <div class="content">
                    <span class="title title--<%= heading_size %>" data-clamp="3"><%= event[:summary] %></span>
                    <% if include_description %><span class="description" data-clamp="3"><%= event[:description].html_safe %></span><% end %>
                    <% if include_event_time %>
                      <div class="flex gap--<%= sub_heading_size %>">
                        <span class="label label--<%= heading_size %> label--<%= event_time_style %>"><%= "#{event[:start]}" %> - <%= event[:end] %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render partial: "plugins/calendars/title_bar", locals: local_assigns %>
</div>
