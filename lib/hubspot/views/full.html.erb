<div class="view view--full">
  <div class="layout">
    <div class="columns">
      <% opportunities.each do |key, value| %>
        <div class="column gap--large">
          <span class="title"><%= key %></span>
          <div class="flex flex--col gap" data-overflow="true" data-overflow-counter="true">
            <% value.each_with_index do |opportunity, idx| %>
              <div class="item">
                <div class="meta">
                  <span class="index"><%= idx + 1 %></span>
                </div>
                <div class="content">
                  <span class="title title--small"><%= opportunity[:name] %></span>
                  <div class="flex gap--xsmall">
                    <span class="label label--small label--underline"><%= opportunity[:value] %></span>
                    <span class="label label--small label--underline">via <%= opportunity[:user] %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="title_bar">
    <%= image_tag plugin_image_path("hubspot--render.svg"), class: "image image--adaptive", alt: "" %>
    <span class="title">HubSpot</span>
    <span class="instance"><%= instance_name %></span>
  </div>
</div>
